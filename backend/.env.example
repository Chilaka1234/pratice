PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dbname

# JWT secret
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend origins (comma-separated) used by CORS in production
# Example: FRONTEND_URLS=https://pratice-1-aswy.onrender.com,http://localhost:5173
FRONTEND_URLS=https://pratice-1-aswy.onrender.com

# Optional single value for legacy clients
FRONTEND_URL=https://pratice-1-aswy.onrender.com

# Optional backend public URL for test scripts
BACKEND_URL=https://pratice-r0fa.onrender.com